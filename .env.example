# =============================================================================
# FluxGrid ERP - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# =============================================================================

# --- Backend: Database ---
# PostgreSQL connection string (REQUIRED)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=fluxgrid;Username=postgres;Password=your-db-password
# PostgreSQL container password for docker-compose. MUST match the connection string above.
# NOTE: changing this does NOT update an already-created container/volume. One-time sync for existing volumes:
#   docker compose exec postgres psql -U postgres -c "ALTER USER postgres PASSWORD '<new-password>';"
POSTGRES_PASSWORD=your-db-password

# --- Backend: JWT ---
# JWT signing secret key - at least 32 characters (REQUIRED)
Jwt__SecretKey=your-jwt-secret-key-min-32-chars-long
# JWT issuer (optional, defaults to "FluxGrid")
Jwt__Issuer=FluxGrid
# JWT audience (optional, defaults to "FluxGrid")
Jwt__Audience=FluxGrid
# JWT token expiry in minutes (optional, defaults to 60)
Jwt__ExpiryMinutes=60

# --- Backend: Hosting ---
# Backend URL (optional, defaults to http://localhost:5020)
ASPNETCORE_URLS=http://localhost:5020

# --- Backend: Seed ---
# Seed admin password (optional). If not set, a random password is generated and logged on first startup.
SEED_ADMIN_PASSWORD=your-seed-admin-password

# --- Backend: Host Validation ---
# Allowed hosts (optional, defaults to "*" in development)
# Set to specific domains in production, e.g. "yourdomain.com"
ALLOWED_HOSTS=*

# --- Backend: CORS ---
# Allowed CORS origins, semicolon-separated (optional, defaults to http://localhost:3000)
# Example: http://localhost:3000;https://app.yourdomain.com
Cors__AllowedOrigins=http://localhost:3000

# --- Backend: MinIO/S3 Storage ---
# MinIO/S3 storage credentials (REQUIRED if Storage:Provider=S3)
Storage__Endpoint=localhost:9004
Storage__AccessKey=your-minio-access-key
Storage__SecretKey=your-minio-secret-key
# MinIO root credentials for docker-compose. MUST match Storage__AccessKey/SecretKey above.
# NOTE: changing these does NOT update an already-created container/volume. One-time sync:
#   docker compose exec minio-flexmng mc alias set local http://localhost:9000 '<user>' '<pass>' (or re-create the volume)
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key

# --- Backend: Groq ---
# Groq API key (REQUIRED) - Generate from https://console.groq.com/keys
Groq__ApiKey=your-groq-api-key-here
Groq__Model=llama-3.1-8b-instant

# --- Frontend ---
# Backend API URL used by the frontend
NEXT_PUBLIC_API_URL=http://localhost:5020
# JWT secret for frontend-side token verification (must match Jwt__SecretKey)
INTERNAL_JWT_SECRET=your-jwt-secret-key-min-32-chars-long
